<%- include('templates/header', { title: 'Home', authenticated, user_type }) %>

<% if (authenticated) { %>
  <div class="text-center py-5">
    <h1 class="display-5">Hello, <strong><%= name %></strong>! Welcome 👋</h1>
    <p class="lead mt-3">You are logged in as <span class="badge bg-<%= user_type === 'admin' ? 'danger' : 'primary' %>"><%= user_type %></span></p>
    <div class="d-flex gap-3 justify-content-center mt-4">
      <a href="/members" class="btn btn-primary btn-lg">Go to Members Area</a>
      <a href="/logout" class="btn btn-outline-secondary btn-lg">Logout</a>
    </div>
  </div>
<% } else { %>
  <div class="text-center py-5">
    <h1 class="display-5">Welcome to the Home Page</h1>
    <p class="lead mt-2">Please sign up or log in to access the members area.</p>
    <div class="d-flex gap-3 justify-content-center mt-4">
      <a href="/signup" class="btn btn-success btn-lg">Sign Up</a>
      <a href="/login" class="btn btn-primary btn-lg">Login</a>
    </div>
  </div>
<% } %>

<%- include('templates/footer') %>
